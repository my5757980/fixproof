# FixProof configuration. Copy to .env and fill in your values. Never commit .env.
# Every variable is read by src/fixproof/config.py. `uv run fixproof doctor` checks them.

# --- Model provider ---
# nebius (the hackathon configuration, default), or a personal-mode provider: nvidia (NVIDIA's
# own API at https://integrate.api.nvidia.com/v1), openrouter (the same Nemotron models as free
# ":free" variants at https://openrouter.ai/api/v1, with a daily request limit), or requesty (the
# NVIDIA IDs at $0 at https://router.requesty.ai/v1, with a larger daily limit). Personal mode is
# usually used with FIXPROOF_EXECUTOR=docker. It changes the default endpoint and model IDs, but
# values set below still win, so for personal mode copy .env.personal.example instead.
FIXPROOF_PROVIDER=nebius
# Personal mode with nvidia only: create a key at https://build.nvidia.com/settings/api-keys
# NVIDIA_API_KEY=
# Personal mode with openrouter only: create a key at https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# Personal mode with requesty only: create a key at https://app.requesty.ai/api-keys
# REQUESTY_API_KEY=

# --- Nebius Token Factory (model inference) ---
# Create a key at https://tokenfactory.nebius.com (API keys).
NEBIUS_API_KEY=your-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- NVIDIA Nemotron models by role ---
# Planner: plans, diagnoses, writes the root cause. Worker: runs the tool loop.
# Fallback: used when a model is unavailable (5xx or not found).
# These are the Token Factory IDs. In personal mode leave them out (each provider has its own
# defaults, listed in .env.personal.example), or set IDs that `fixproof doctor` shows as listed.
FIXPROOF_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
FIXPROOF_WORKER_MODEL=nvidia/nemotron-3-super-120b-a12b
FIXPROOF_FALLBACK_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b

# Sampling parameters are always sent explicitly, never left to provider defaults.
FIXPROOF_TEMPERATURE=0.3
FIXPROOF_TOP_P=0.95
FIXPROOF_MAX_TOKENS=4096

# Optional price-table override, USD per 1M tokens: {"model-id": [input, output]}
# FIXPROOF_PRICES={"nvidia/nemotron-3-super-120b-a12b": [0.30, 0.90]}

# --- Token Factory Sandboxes (code execution) ---
# Request access at https://tokenfactory.nebius.com/sandboxes/about
CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
# Project ID from the Token Factory console (NEBIUS_PROJECT_ID, the name contree-sdk uses, also works).
CONTREE_PROJECT=your-sandboxes-project-id
# Only needed if the sandbox token differs from NEBIUS_API_KEY:
# CONTREE_TOKEN=

# Executor: contree (default, required for the demo and video) or docker (DEV ONLY).
FIXPROOF_EXECUTOR=contree
FIXPROOF_BASE_IMAGE=python:3.12

# --- Optional services ---
# Server-side, read-only GitHub token for higher API limits. Never sent into sandboxes.
# GITHUB_TOKEN=
# Optional web search for documentation and error messages. Off by default; sends short
# queries only, never source files.
# TAVILY_API_KEY=
FIXPROOF_WEB_SEARCH=0

# --- Dev and test switches ---
# Allows the Docker executor or a non-Nebius endpoint for local UI testing.
# NEVER set this to 1 on the public demo.
FIXPROOF_ALLOW_DEV=0
# Set to 1 to run the live tests against Nebius (tests/live).
FIXPROOF_LIVE=0

# --- Run storage and judge-demo limits ---
FIXPROOF_STATE_DIR=runs
FIXPROOF_DEMO_MAX_CONCURRENT=2
FIXPROOF_DEMO_RUNS_PER_VISITOR=3
FIXPROOF_DEMO_DAILY_CAP_USD=2.0
FIXPROOF_DEMO_MAX_REPO_MB=50
# Estimated Sandboxes cost per sandbox minute; set once pricing is known.
FIXPROOF_SANDBOX_COST_PER_MIN_USD=0.0
# Public demo URL, used by the daily uptime check.
# FIXPROOF_DEMO_URL=https://your-space.hf.space
# FIXPROOF_SHOWCASE=1   # replays only, no live runs (public showcase without model keys)
