# FixProof personal mode (constitution 2.1.0, FR-024): NVIDIA's own API for the Nemotron models
# and the local Docker executor. This is NOT the hackathon platform.
#
# Copy this file to .env (instead of .env.example) and put in your key. Never commit .env.
# It leaves out the Nebius-only lines on purpose: an explicit NEBIUS_BASE_URL or Token Factory
# model ID would override the personal-mode defaults. Then run `uv run fixproof doctor`.

FIXPROOF_PROVIDER=nvidia
# Create a key at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your-nvidia-api-key

# Code runs in local Docker containers (Docker Desktop must be running).
FIXPROOF_EXECUTOR=docker
FIXPROOF_BASE_IMAGE=python:3.12

# Optional: other NVIDIA model IDs, if `fixproof doctor` says a default is not listed.
# FIXPROOF_PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# FIXPROOF_WORKER_MODEL=nvidia/nemotron-3-super-120b-a12b
# FIXPROOF_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
